PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/multi_vendor_ecommerce?retryWrites=true&w=majority
# Comma-separated list for customer (3000), vendor (3001), admin (3002) apps
# Prefer opening frontends as http://localhost:PORT (not the LAN Network URL).
# In development, same ports on LAN IPs (e.g. http://192.168.x.x:3000) are also allowed.
CLIENT_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
# Legacy single-origin fallback (optional if CLIENT_ORIGINS is set)
CLIENT_ORIGIN=http://localhost:3000
NODE_ENV=development

# Required secrets — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ISSUER=multi-vendor-ecommerce
JWT_AUDIENCE=multi-vendor-ecommerce-api
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_MS=604800000
REFRESH_COOKIE_NAME=refreshToken
BCRYPT_ROUNDS=12

# Optional — used only by `npm run seed:admin` (never commit real values)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=Password1
# ADMIN_FULL_NAME=Platform Admin
